# Starfetch backend — EXAMPLE environment file.
# Copy to `.env` and fill in LOCAL values. NEVER commit real secrets or credentials.

# Node environment: development | test | staging | production
NODE_ENV=development

# Port the API listens on (binds 0.0.0.0).
PORT=4000

# ── Database (REQUIRED for Phase 2B application runtime) ─────────────────────
# PostgreSQL system of record. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# - Phase 2B application runtime: DATABASE_URL is REQUIRED — startup validation
#   fails without it, and functional authentication requires a REACHABLE
#   PostgreSQL instance.
# - Prisma schema validation (`npx prisma validate`): requires only a
#   syntactically valid URL — a temporary LOCAL-ONLY placeholder works, no live
#   database needed (see README "Application runtime vs Prisma CLI").
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starfetch_dev

# ── Authentication secrets (REQUIRED in every environment) ────────────────────
# Generate real secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url')"
# Staging/production REJECT secrets shorter than 32 chars or known placeholders.
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-replace-locally
CSRF_HMAC_SECRET=dev-only-csrf-hmac-secret-replace-locally
EMAIL_VERIFICATION_HMAC_SECRET=dev-only-email-hmac-secret-replace-locally

# Token/session lifetimes (seconds) — approved Phase 2B contract values.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_IDLE_TTL_SECONDS=86400

# ── SMTP (email verification delivery) ────────────────────────────────────────
# Local development: run a catcher, e.g. Mailpit → SMTP_HOST=127.0.0.1 SMTP_PORT=1025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Starfetch <no-reply@starfetch.local>"
# Optional authenticated relay (staging/production) — never commit real values:
# SMTP_USER=
# SMTP_PASS=

# Comma-separated browser origins allowed by CORS + cookie-authenticated
# Origin policy (development example below). Mobile clients do not use CORS.
# Leave empty to deny cross-origin browser access.
CORS_ORIGINS=http://localhost:3000

# Server-side auth throttling (default true; auto-disabled under NODE_ENV=test).
# RATE_LIMIT_ENABLED=true

# Version string reported by GET /api/v1/health (informational only).
API_VERSION=0.0.1
