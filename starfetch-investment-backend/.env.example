# Starfetch backend — EXAMPLE environment file.
# Copy to `.env` and fill in local values. NEVER commit real secrets or credentials.

# Node environment: development | test | staging | production
NODE_ENV=development

# Port the API listens on (binds 0.0.0.0).
PORT=4000

# PostgreSQL connection string — REQUIRED ONLY FOR LATER DATABASE PHASES.
# The Phase 2A scaffold boots and serves /api/v1/health without a database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# NOTE: an empty value here is fine for the APPLICATION runtime, but Prisma CLI
# commands (e.g. `npx prisma validate`) require a syntactically valid, non-empty
# PostgreSQL URL. Supply a temporary LOCAL-ONLY placeholder when running Prisma
# CLI commands (see README "Application runtime vs Prisma CLI"). A placeholder is
# not a real credential, does not provision a database, and authorizes NO migration.
DATABASE_URL=

# Comma-separated browser origins allowed by CORS (development example shown below).
# Mobile clients (Android/iOS) do not use CORS. Leave empty to deny cross-origin browser access.
CORS_ORIGINS=http://localhost:3000

# Version string reported by GET /api/v1/health (informational only).
API_VERSION=0.0.1
