// ─────────────────────────────────────────────────────────────────────────────
// Starfetch Investment Limited — Prisma schema
// Phase 2A: tooling foundation. Phase 2B: authentication / identity.
// Phase 2C: investor profile field (phone). Phase 2D: investor dashboard
// read models (Portfolio / Holding / Transaction — READ-only APIs; records
// are created only by future real business flows, never seeded as fakes).
//
// Authorized model set:
//
//   Auth/identity: User, InvestorProfile, EmailVerificationChallenge,
//                  AuthSession, RefreshToken (+ enum UserRole)
//   Dashboard:     Portfolio, Holding, Transaction
//
// Still explicitly EXCLUDED pending approvals:
//   - D-08: application status / state-transition map .................. OPEN
//   - D-09: one-active-application semantics (+ staff-list selection) .. OPEN
//   - Document categories / review outcomes / lifecycle vocabulary ..... TBD
//     (BUSINESS / COMPLIANCE + CONTRACT APPROVAL REQUIRED)
//   - Applications / KYC / documents / banking / payments / investments /
//     statements / NAV / ledger / trades /
//     settlement / IMS ..................................... NOT AUTHORIZED
//
// Security posture (see docs/backend/auth/AUTH-SECURITY-CONTRACT-v1.md):
//   - passwords: Argon2id hash strings only
//   - verification codes: keyed HMAC-SHA-256 verifier only (never plaintext)
//   - refresh credentials: SHA-256 hash only (raw 384-bit opaque value is
//     never persisted)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Approved Phase-2B role vocabulary. Public registration may only create INVESTOR.
enum UserRole {
  INVESTOR
  STAFF
  ADMIN
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Display email exactly as the user typed it (trimmed).
  email           String
  /// Trim + lowercase comparison value; unique to prevent casing duplicates.
  normalizedEmail String    @unique
  /// Argon2id password hash (PHC string). Never returned by any API.
  passwordHash    String
  role            UserRole  @default(INVESTOR)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  investorProfile             InvestorProfile?
  portfolio                   Portfolio?
  emailVerificationChallenges EmailVerificationChallenge[]
  authSessions                AuthSession[]
  // Phase 3B Step 1 — joint account back-relations (no scalar columns added).
  jointMemberships       JointAccountMember[]
  createdJointAccounts   JointAccount[]           @relation("CreatedJointAccounts")
  sentJointInvitations   JointAccountInvitation[] @relation("SentJointInvitations")
  acceptedJointInvitations JointAccountInvitation[] @relation("AcceptedJointInvitations")

  @@map("users")
}

model InvestorProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  /// Approved OPTIONAL profile field (D-06 v1/contract rows 8–9). Nullable;
  /// nothing else (BVN/NIN/DOB/address/…) is approved for this model.
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("investor_profiles")
}

/// Phase 2D — investor dashboard read models. Money is ALWAYS stored in minor
/// units (kobo for NGN) as BigInt. Type/status vocab is NOT contract-locked
/// yet, so these stay plain strings until an approved contract pins them.
/// Records are written only by real business flows (later phases) — the
/// dashboard NEVER seeds demo/fake rows.
///
/// Phase 3B Step 1 (Joint Investor foundation — reviewed Phase 3A Option B):
/// ownership is EXACTLY-ONE-OF (userId XOR jointAccountId). Existing individual
/// rows keep userId set / jointAccountId NULL; joint rows are the inverse.
/// The XOR rule is enforced by a PostgreSQL CHECK added via the hand-authored
/// SQL block inside the generated migration (Prisma does not emit CHECK
/// constraints) — see prisma/migrations documentation + docs/backend/joint/.
model Portfolio {
  id             String        @id @default(uuid()) @db.Uuid
  /// Individual owner — NOW NULLABLE (Phase 3B). Unique 1:1 rule preserved.
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?       @unique @db.Uuid
  /// Joint account owner (Option B). Restricted delete: an account owning
  /// financial records cannot be removed at the database level.
  jointAccount   JointAccount? @relation(fields: [jointAccountId], references: [id], onDelete: Restrict)
  jointAccountId String?       @unique @db.Uuid
  holdings       Holding[]
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("portfolios")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3B Step 1 — Joint Investor account foundation (schema ONLY; REST
// endpoints and business services are NOT implemented in this step).
// Identity (User) and account membership (JointAccountMember) are separate
// concerns; there is deliberately NO new user role (J-02).
// ─────────────────────────────────────────────────────────────────────────────

/// A shared investment account belonging to at most two ACTIVE holders.
/// One-member accounts are a normal intermediate state while the second
/// holder's invitation is pending consent — never presented as fully
/// established or KYC-verified.
model JointAccount {
  id          String  @id @default(uuid()) @db.Uuid
  /// Optional display label chosen at creation.
  displayName String  @db.VarChar(60)
  /// Initiating holder — audit only; authorization derives from member rows.
  createdBy       User   @relation("CreatedJointAccounts", fields: [createdByUserId], references: [id])
  createdByUserId String @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     JointAccountMember[]
  invitations JointAccountInvitation[]
  portfolio   Portfolio?

  @@map("joint_accounts")
}

/// ACTIVE membership only (pending relationships live in JointAccountInvitation).
/// Capacity (max 2) is enforced by the future transactional acceptance flow via
/// parent-row locking — documented in docs/backend/joint/03 §3 (Phase 3B Step 2+).
model JointAccountMember {
  id             String       @id @default(uuid()) @db.Uuid
  jointAccount   JointAccount @relation(fields: [jointAccountId], references: [id], onDelete: Cascade)
  jointAccountId String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// Duplicate membership is impossible regardless of application races.
  @@unique([jointAccountId, userId])
  @@index([userId])
  @@map("joint_account_members")
}

/// Invitation-scoped vocabulary — intentionally disjoint from the OPEN
/// D-08/D-09 application vocabulary. Native PostgreSQL enum in the database.
enum JointInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

/// Login-only inbox model: the email carries only a page link, never an
/// authorization credential. Recipient identity is proven server-side against
/// the caller's CURRENT User record (normalizedEmail + emailVerifiedAt); email
/// values are stored plaintext ONLY for delivery and are masked in responses.
model JointAccountInvitation {
  id                     String                 @id @default(uuid()) @db.Uuid
  jointAccount           JointAccount           @relation(fields: [jointAccountId], references: [id], onDelete: Cascade)
  jointAccountId         String                 @db.Uuid
  invitedEmailNormalized String
  /// Plaintext for delivery; masked in any future API response.
  invitedEmail           String
  invitedBy              User                   @relation("SentJointInvitations", fields: [invitedByUserId], references: [id])
  invitedByUserId        String                 @db.Uuid
  /// Set at acceptance — supports the idempotent authorized-replay path.
  acceptedBy             User?                  @relation("AcceptedJointInvitations", fields: [acceptedByUserId], references: [id])
  acceptedByUserId       String?                @db.Uuid
  status                 JointInvitationStatus  @default(PENDING)
  expiresAt              DateTime
  respondedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([invitedEmailNormalized, status])
  @@index([jointAccountId, status])
  @@map("joint_account_invitations")
}

model Holding {
  id              String   @id @default(uuid()) @db.Uuid
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId     String   @db.Uuid
  instrumentLabel String
  /// Nullable quantity (Decimal serialized as string in API output).
  quantity        Decimal? @db.Decimal(20, 6)
  /// Stored holding value in minor units — read-only aggregation source for
  /// the dashboard; NO market valuation or revaluation exists.
  valueMinor      BigInt
  currency        String   @default("NGN")
  asOf            DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([portfolioId])
  @@map("holdings")
}

model Transaction {
  id          String   @id @default(uuid()) @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId String   @db.Uuid
  /// Business vocabulary strings (e.g. type/status) are pinned by a later
  /// approved contract — deliberately free-form here.
  type        String
  status      String
  /// Signed minor units (credit positive / debit negative).
  amountMinor BigInt
  currency    String   @default("NGN")
  description String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([portfolioId, occurredAt(sort: Desc)])
  @@map("transactions")
}

/// Email-ownership challenge: 6-digit code, 10-minute lifetime, 5 attempts,
/// 60s resend cooldown, max 5 resends/hour. Only a keyed HMAC of the code is
/// stored; resends rotate code/verifier/timestamps; success consumes it.
model EmailVerificationChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// HMAC-SHA-256(key=EMAIL_VERIFICATION_HMAC_SECRET, "<challengeId>.<code>")
  codeHmac  String
  expiresAt DateTime
  /// Set on successful verification (code is single-use).
  consumedAt DateTime?
  /// Set when attempts are exhausted (code becomes permanently unusable).
  revokedAt DateTime?
  attemptCount          Int       @default(0)
  resendCount           Int       @default(0)
  resendWindowStartedAt DateTime  @default(now())
  lastSentAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("email_verification_challenges")
}

/// Server-side session: absolute 7-day lifetime, 24-hour sliding idle window,
/// revocable. Reuse of an old refresh credential revokes the whole session.
model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  /// Absolute expiry: createdAt + REFRESH_TOKEN_TTL_SECONDS (7 days).
  expiresAt     DateTime
  /// Sliding idle expiry: lastUsedAt + REFRESH_IDLE_TTL_SECONDS (24 hours).
  idleExpiresAt DateTime
  revokedAt     DateTime?
  revokeReason  String?

  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("auth_sessions")
}

/// One refresh credential per rotation hop. Raw token never stored —
/// tokenHash = SHA-256(raw). On success the token is marked used and chained
/// to its replacement via replacedByTokenId.
model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the raw opaque refresh credential. Never the token itself.
  tokenHash String      @unique
  createdAt DateTime    @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  replacedByTokenId String? @db.Uuid

  @@index([sessionId])
  @@map("refresh_tokens")
}
